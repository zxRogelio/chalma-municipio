# Entorno de produccion de ejemplo. No usar credenciales reales en este archivo.
NODE_ENV=production
PORT=3000

FRONTEND_URL=https://www.ejemplo.gob.mx
CORS_ORIGINS=https://www.ejemplo.gob.mx

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nombre_base
DB_USER=nombre_usuario
DB_PASSWORD=REEMPLAZAR
DB_LOGGING=false

JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_LARGO_DE_32_O_MAS_CARACTERES
JWT_EXPIRES_IN=8h

COOKIE_NAME=chalma_admin_sesion
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

TRUST_PROXY=true
MAX_FILE_SIZE_MB=20
